# .env.example — шаблон переменных окружения.
# Скопируй в .env и впиши реальные значения. .env в репозиторий НЕ коммитится.
#
# ─────────────────────────────────────────────────────────────────────────────
# СЕРВЕР (на Amvera задаётся в панели проекта; здесь — для справки и локального
# запуска). Точка входа server/index.js.
# ─────────────────────────────────────────────────────────────────────────────

# Подключение к PostgreSQL. На Amvera — ВНУТРЕННИЙ адрес (оканчивается на «-rw»).
# Для служебных скриптов с внешней машины — ВНЕШНИЙ адрес (…amvera.tech), с TLS.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Подпись сессионных cookie. Длинная случайная строка. openssl rand -hex 32
SESSION_SECRET=

# Первый администратор — РАЗОВО. Формат «почта:пароль». После первого старта
# сервер заведёт этого админа; затем переменную из настроек УБРАТЬ.
BOOTSTRAP_ADMIN=admin@example.com:changeme

# Порт. Должен совпадать с containerPort в amvera.yml (3000).
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# ОБЩИЙ СЕКРЕТ ПРИЁМНИКА ИНВЕНТАРЯ (/api/ingest)
# ─────────────────────────────────────────────────────────────────────────────
# Просто СТРОКА, произвольный формат/длина/charset. Сервер сверяет её точным
# равенством с тем, что присылает клиент (body.secret). Рекомендуется длинная
# случайная: openssl rand -hex 32 — без пробелов, переводов строки и кавычек.
#
# ОДНО И ТО ЖЕ значение должно стоять в трёх местах:
#   1) у сервера          — переменная SYNC_SECRET (панель Amvera),
#   2) у расширения        — extension/config.js (из config.example.js),
#   3) у служебного сборщика инвентаря (см. блок ниже).
SYNC_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# СЛУЖЕБНЫЙ КЛИЕНТ СИНХРОНИЗАЦИИ — сборщик, который шлёт инвентарь в /api/ingest
# и (опционально) правит структуру/данные через /api под админом.
# Эти переменные читает инструмент на стороне сопровождающего, НЕ сервер.
# ─────────────────────────────────────────────────────────────────────────────

# Развёрнутая база:
PAI_BASE_URL=https://pai-traffbaza-grafenters.amvera.io
# Приёмник инвентаря:
PAI_INGEST_URL=https://pai-traffbaza-grafenters.amvera.io/api/ingest

# Логин администратора приложения — для правок колонок/данных через /api.
# Нужен только для структурных изменений; для наполнения аккаунтами достаточно
# SYNC_SECRET выше.
PAI_ADMIN_EMAIL=
PAI_ADMIN_PASSWORD=
